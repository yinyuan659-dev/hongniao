# 复制到服务器 /opt/hongniang/.env 并填值（chmod 600）。真实的 .env 不入库。
# 密码类只用字母数字，避免在 DATABASE_URL 里要转义。

# 对外访问地址（不带结尾斜杠）。2026-11-27 备案通过后是 https://gphnai.com（之前是 http://服务器IP）
PUBLIC_BASE=https://gphnai.com

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 任意长随机串
JWT_SECRET=
# 必须是 64 位 hex（32 字节）。上线后不能换：换了以后旧聊天消息解不开
MASTER_KEY=

# 后台 admin 账号的初始密码（只在第一次建库时生效）
ADMIN_INIT_PASSWORD=

# AI（AI_API_KEY 留空则用「平台余额」的 AI 功能不可用；用户填自己的 Key 不受影响）
# 模型名用 deepseek-flash 或 deepseek-v4-pro（DeepSeek 已经没有 deepseek-chat 这个名字了）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash

# 实人认证。mock = 测试假核验（不花钱、固定通过）；aliyun = 阿里云金融级实人认证（真刷脸，刷完出结果就收 1 元，通过不通过都收）。
# aliyun 要填下面三样：只有 AliyunAntCloudAuthFullAccess 权限的子账号的 AccessKey，和控制台「接入场景设置」里的场景 ID。
KYC_PROVIDER=mock
KYC_ALIYUN_ACCESS_KEY_ID=
KYC_ALIYUN_ACCESS_KEY_SECRET=
KYC_ALIYUN_SCENE_ID=

# 通话用的 SRS，填本机公网 IP（compose 里的 srs 容器用它做 candidate；留空则通话不可用）。
# SRS_SERVER = 本机公网 IP（媒体走它的 UDP 8000，安全组要放行 UDP 8000，注意是 UDP 不是 TCP）
# SRS_API = 信令地址。2026-11-27 起信令走 nginx 的 HTTPS：SRS_API=https://gphnai.com（App 已经不发明文请求，不能再填 http://IP:1985）
# 例：SRS_SERVER=1.2.3.4  SRS_API=https://gphnai.com
# 注意：全新建库时 seed 仍会把节点录成「SRS_SERVER:1985」（http），要到后台「SRS 节点」里把它改成「gphnai.com : 443」才是 HTTPS。
# 只在第一次建库时由 seed 录入「SRS 节点」表，之后在后台改。
SRS_SERVER=
SRS_API=
