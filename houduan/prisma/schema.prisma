generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 平台核心：用户 ----------

model User {
  id           BigInt   @id @default(autoincrement())
  /// 一机一号：设备 ID 唯一绑定账号，卸载重装凭此恢复
  deviceId     String   @unique @map("device_id") @db.VarChar(80)
  /// 6 位数字短号，对外展示使用
  shortId      String?  @unique @map("short_id") @db.VarChar(6)
  nickname     String   @db.VarChar(30)
  avatar       String   @default("") @db.VarChar(255)
  /// 1=男 2=女，注册后锁定，全局性别隔离依据
  gender       Int      @db.TinyInt
  age          Int      @default(0)
  cityCode     String   @default("") @map("city_code") @db.VarChar(12)
  cityName     String   @default("") @map("city_name") @db.VarChar(30)
  signature    String   @default("") @db.VarChar(200)
  latitude     Decimal? @db.Decimal(10, 6)
  longitude    Decimal? @db.Decimal(10, 6)
  isGuide      Boolean  @default(false) @map("is_guide")
  /// 女生自定视频通话价（分/分钟），0=使用平台默认价；不得低于平台下限
  videoPriceFen Int     @default(0) @map("video_price_fen")
  /// 评分均分缓存（0-100，仅女生），评分越高广场推荐越靠前
  ratingAvg    Int      @default(0) @map("rating_avg")
  /// 被评分次数缓存
  ratingCount  Int      @default(0) @map("rating_count")
  /// 【旧·已停用】原免费方案的实名姓名（只验校验位）。M1 实人认证上线后不再写入，存量清空。
  realName     String   @default("") @map("real_name") @db.VarChar(30)
  /// 【旧·已停用】原免费方案的身份证号明文。M1 改为只存哈希（idHash），此列不再写入、存量清空。列保留不删。
  idCard       String?  @unique @map("id_card") @db.VarChar(18)
  /// 实人认证：身份证号的带密钥哈希（HMAC-SHA256，密钥从 MASTER_KEY 派生），一证一号；不存证号明文、不存人脸照片
  idHash       String?  @unique @map("id_hash") @db.VarChar(64)
  /// 实人认证状态：0 未认证 1 已通过（通过的一定已满 18 岁，未成年在认证时就被拒）
  realStatus   Int      @default(0) @map("real_status") @db.TinyInt
  /// 实人认证通过时间
  realAt       DateTime? @map("real_at")
  /// 0=正常 1=封禁
  status       Int      @default(0) @db.TinyInt
  /// 邀请人 id：通过 TA 的专属邀请页（/t/?u=短号）下载注册时归因，注册时写入一次
  inviterId    BigInt?  @map("inviter_id")
  /// 后台「隐藏」：不出现在 App 的遇见 / 找人 / 搜索用户 / 动态广场里；已有的聊天、关注不受影响
  hidden       Boolean  @default(false)
  /// 视频见面开关：默认关闭；自己和对方都打开后才能互相发起视频通话（不收费）
  allowVideo   Boolean  @default(false) @map("allow_video")
  /// 并号：这个号已经作废、并进了哪个账号（同一张身份证的老账号）。有值的同时 status=1，不能再登录、不再出现在任何列表里
  mergedInto   BigInt?  @map("merged_into")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet       Wallet?
  albums       UserAlbum[]

  @@index([gender, isGuide, cityCode])
  @@index([inviterId])
  @@map("user")
}

/// 登录设备：一个账号可以挂多台设备（手机 + 网页）。账号认人（身份证），设备只是登录这个账号的钥匙。
/// user.device_id 是注册时的那台设备，第一次用到时在这里补一行；之后一律以这张表为准。
/// 一台设备同一时间只属于一个账号（deviceId 唯一）。新设备要挂到已有账号上，必须本人刷脸（找回 / 并号）。
model UserDevice {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  deviceId   String    @unique @map("device_id") @db.VarChar(80)
  /// android | ios | web（按设备号前缀 and_ / ios_ / web_ 判断）
  kind       String    @db.VarChar(10)
  /// 网页的浏览器名（Chrome / Safari…），App 为空
  label      String    @default("") @db.VarChar(30)
  /// 怎么挂到这个账号上的：register 注册 | recover 刷脸找回 | merge 并号带过来
  via        String    @default("register") @db.VarChar(10)
  /// 被移除的时间（移除后这台设备马上退出，想再用要重新刷脸找回）
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// 挂到当前这个账号上的时间
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_device")
}

/// 实人认证记录：一次认证一条（身份证 + 刷脸，阿里云金融级实人认证，或测试期的 mock）。
/// 只存结果和供应商流水号，不存证号明文、不存人脸照片。通过才扣费（¥1，从 AI 余额按成本价扣，不加手续费）。
model KycRecord {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// 供应商流水号（阿里云 CertifyId）或测试期本地生成的 id，用来查结果
  certifyId String   @unique @map("certify_id") @db.VarChar(64)
  /// mock（测试假核验）/ aliyun（真实人认证）
  provider  String   @db.VarChar(16)
  /// 身份证号哈希，认证通过时才写进 user.idHash（发起时先存在这，避免用别人证号「占位」）
  idHash    String   @default("") @map("id_hash") @db.VarChar(64)
  /// pending 发起了还没出结果 | passed 通过 | failed 没通过 | merge_ready 并号：刷脸通过了、等用户点确认 | merged 并号完成
  status    String   @default("pending") @db.VarChar(12)
  /// 这次刷脸是干什么的：kyc 真人认证 | recover 新设备刷脸找回（userId 是要找回的那个账号）| merge 并号（userId 是新号，targetUserId 是老账号）
  purpose   String   @default("kyc") @db.VarChar(10)
  /// 并号时的老账号
  targetUserId BigInt? @map("target_user_id")
  /// 找回时发起的那台设备（只有这台设备能来查结果）
  deviceId  String   @default("") @map("device_id") @db.VarChar(80)
  /// 没通过的原因（给用户看）
  reason    String   @default("") @db.VarChar(60)
  /// 这次扣了多少（微元，通过才扣）；扣费幂等键是 kyc:certifyId
  costMicro BigInt   @default(0) @map("cost_micro")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("kyc_record")
}

/// 专属邀请页访问记录：页面加载/点下载时记一条（IP + 平台），
/// 新设备注册时用「同 IP + 同平台 + 48h 内最近一条未消费」做安装归因（无需剪贴板）
model InviteClick {
  id        BigInt    @id @default(autoincrement())
  inviterId BigInt    @map("inviter_id")
  ip        String    @db.VarChar(64)
  /// ios / android / other（按访问页面的 UA 判断）
  platform  String    @db.VarChar(10)
  ua        String    @default("") @db.VarChar(300)
  /// 归因到的新用户 id（消费后不再参与匹配）
  claimedBy BigInt?   @map("claimed_by")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([ip, platform, createdAt])
  @@index([inviterId, createdAt])
  @@map("invite_click")
}

/// 亲密度（有向对：owner 视角对 peer 的分数）。
/// 记分规则：任何互动（消息/点赞/评论/视频每分钟）发起方 +1、接受方 +0.5；
/// score 以 x10 整数存储（半分粒度），展示时 /10。
model Intimacy {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  peerId    BigInt   @map("peer_id")
  /// 分数 x10（10 = 1 分）
  score     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, peerId])
  @@index([userId, score])
  @@map("intimacy")
}

/// 相亲画像：AI 红娘资料收集（男 / 女两套标准问题，见 src/hn/interview.template.ts）的结果。
/// 确认后才算「完成资料收集」；没完成的人不能主动发起聊天和通话。
model Profile {
  userId      BigInt    @id @map("user_id")
  /// 原始回答 { 题目 key: string[] }；单选 / 填空是一个元素，多选多个，「先不说」是空数组
  answers     Json
  /// 硬条件（匹配时做过滤用）：出生年份、身高、城市、学历、婚史、择偶要求等
  hard        Json
  /// 软信息：{ tags: string[], summary: string, ... }
  soft        Json
  /// 问题模板版本
  version     Int       @default(1)
  /// 用户确认画像的时间；null = 还没完成资料收集
  confirmedAt DateTime? @map("confirmed_at")
  /// AI 深聊后整理的画像（已确认、已生效）：{ summary, tags, rows: [{ key, label, value }] }
  deep        Json?
  /// AI 刚整理出来、用户还没点确认的画像；确认后挪到 deep
  deepDraft   Json?     @map("deep_draft")
  deepConfirmedAt DateTime? @map("deep_confirmed_at")
  /// 需要对方注意的事：AI 在深聊里听到本人自己说的严重负面情况（暴力倾向、赌博、只图彩礼等），字符串数组。
  /// 一说出来就记下，本人不能改、不能删，重新聊也不会消失，对方在画像里能看到；记错了只能由后台清掉。
  flags       Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("profile")
}

/// AI 深聊：一个用户同一时间只有一场进行中的；聊完整理成画像
model DeepSession {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// chatting 聊天中 | draft 画像已整理、等用户确认 | done 已确认
  status    String   @default("chatting") @db.VarChar(10)
  /// 当前聊到第几个话题（0～5；6 = 六个话题都聊过了，自由补充）
  topic     Int      @default(0)
  /// 当前话题已经聊了几轮
  turns     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, id])
  @@map("deep_session")
}

model DeepMessage {
  id        BigInt   @id @default(autoincrement())
  sessionId BigInt   @map("session_id")
  /// ai | user
  role      String   @db.VarChar(6)
  /// 内容用服务端主密钥加密（和聊天消息一样不存明文）
  cipher    String   @db.Text
  /// AI 这句话附带的现成回答
  quick     Json?
  topic     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, id])
  @@map("deep_message")
}

// ---------- 每日推荐、喜欢 / 跳过、互相喜欢后才能聊天 ----------

/// 我对某个人的态度（有向）：一对人一个方向一条。两边都是 like = 互相喜欢，才能聊天。
model MatchAction {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  targetId  BigInt    @map("target_id")
  /// like 喜欢 | pass 跳过 / 不合适（以后不再互相推荐，对方不知道）| end 聊过以后「不合适，不再联系」| none 取消了喜欢
  kind      String    @db.VarChar(6)
  /// rec 每日推荐里点的 | back 回应对方的喜欢 | browse 在遇见 / 画像里自己点的（只有这种占每天的名额）
  source    String    @default("browse") @db.VarChar(8)
  /// 这次喜欢占的是哪一天的名额（推荐日，见 common/chat-gate.ts 的 recDay）；不占名额的是 null。取消喜欢不退名额
  quotaDay  String?   @map("quota_day") @db.VarChar(10)
  likedAt   DateTime? @map("liked_at")
  /// 互相喜欢的时间（两边的记录都写）
  matchedAt DateTime? @map("matched_at")
  /// 对方有没有在「喜欢我的」里看到过这条喜欢（没看过的算进消息页的提醒数字）
  seen      Boolean   @default(false)
  /// 我有没有看过这次互相喜欢的庆祝页（没看过的下次打开 App 时补弹）
  matchSeen Boolean   @default(false) @map("match_seen")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, targetId])
  @@index([targetId, kind])
  @@index([userId, quotaDay])
  @@map("match_action")
}

/// 每日推荐：一个人一个推荐日一批（默认 3 位），生成以后当天不变；人不够时有几位存几位，之后有新的合适的人再补
model MatchRec {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// 推荐日：北京时间上午 10 点换日，例如 2026-11-23
  day       String   @db.VarChar(10)
  targetId  BigInt   @map("target_id")
  sort      Int      @default(0)
  /// 规则打出来的分（越高越合适），只用来排序和排查
  score     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, day, targetId])
  @@index([userId, targetId])
  @@map("match_rec")
}

/// AI 写的推荐理由和开场白（看的人 → 被看的人）。写过一次就存在这里，不重复花钱
model MatchReason {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  targetId    BigInt   @map("target_id")
  /// 推荐理由；空 = 还没写成（没有余额也没有 Key，或者 AI 当时不可用）
  text        String   @default("") @db.VarChar(300)
  /// 互相喜欢后 AI 帮我想的开场白（字符串数组）；null = 还没写
  icebreakers Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, targetId])
  @@map("match_reason")
}

// ---------- AI 费用（和旧的积分钱包 wallet 表无关） ----------

/// AI 余额（单位微元：1 元 = 1,000,000）+ 付费方式 + 用户自己的 Key
model AiWallet {
  userId       BigInt    @id @map("user_id")
  balance      BigInt    @default(0)
  /// platform = 平台余额（DeepSeek 实际费用 + 手续费）；own = 用户自己的 Key（平台不收费）
  payMode      String    @default("platform") @map("pay_mode") @db.VarChar(10)
  /// 用户自己的 DeepSeek Key，用服务端主密钥加密；空 = 没填
  keyEnc       String    @default("") @map("key_enc") @db.VarChar(500)
  /// Key 的最后 4 位，只用来显示
  keyTail      String    @default("") @map("key_tail") @db.VarChar(8)
  keyCheckedAt DateTime? @map("key_checked_at")
  /// 自己的 Key 用不了时自动改用平台余额（默认关：先停下来问用户）
  autoFallback Boolean   @default(false) @map("auto_fallback")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("ai_wallet")
}

/// AI 余额流水，只追加。userId + type + refKey 唯一，重复提交不会重复记账
model AiLedger {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  /// topup 充值 / 平台发放 | usage AI 调用扣费
  type         String   @db.VarChar(12)
  /// 正数进账、负数扣款（微元）
  amount       BigInt
  balanceAfter BigInt   @map("balance_after")
  /// usage = 那次调用的 requestId；topup = 订单号 / 发放批次号
  refKey       String   @map("ref_key") @db.VarChar(64)
  note         String   @default("") @db.VarChar(60)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, type, refKey])
  @@index([userId, id])
  @@map("ai_ledger")
}

/// 每次模型调用一条（用平台余额、用自己的 Key 都记；自己的 Key 不扣费）
model AiUsage {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  /// deep 深聊 | portrait 整理画像 | keytest 测试 Key
  feature    String   @db.VarChar(20)
  /// 明细里合成一条显示的分组，例如 deep:12
  groupKey   String   @map("group_key") @db.VarChar(40)
  model      String   @db.VarChar(40)
  hitTokens  Int      @map("hit_tokens")
  missTokens Int      @map("miss_tokens")
  outTokens  Int      @map("out_tokens")
  /// 调用时是不是 DeepSeek 的空闲时段（半价）
  offpeak    Boolean  @default(false)
  /// 按 DeepSeek 官方价算出来的模型费（微元）
  costMicro  BigInt   @map("cost_micro")
  /// 平台手续费（微元）；用自己的 Key 时是 0
  feeMicro   BigInt   @map("fee_micro")
  /// platform | own
  payMode    String   @map("pay_mode") @db.VarChar(10)
  requestId  String   @unique @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, id])
  @@index([userId, groupKey])
  @@map("ai_usage")
}

model UserAlbum {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// 1=图片 2=视频
  type      Int      @db.TinyInt
  url       String   @db.VarChar(255)
  coverUrl  String   @default("") @map("cover_url") @db.VarChar(255)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_album")
}

// ---------- 平台核心：IM ----------

/// 单聊会话
model Conversation {
  id          BigInt   @id @default(autoincrement())
  /// 1=单聊 2=群聊
  type        Int      @default(1) @db.TinyInt
  /// 单聊唯一键：{minUserId}_{maxUserId}；群聊是 g_{groupId}
  pairKey     String   @unique @map("pair_key") @db.VarChar(50)
  userAId     BigInt?  @map("user_a_id")
  userBId     BigInt?  @map("user_b_id")
  /// 群聊才有：对应 chat_group.id（2026-11-27 加的列）
  groupId     BigInt?  @unique @map("group_id")
  /// 会话 AES-256-GCM 密钥（单聊每会话一把、群聊每群一把），经服务端主密钥包裹后存储
  wrappedKey  String   @map("wrapped_key") @db.VarChar(200)
  lastMsgAt   DateTime @default(now()) @map("last_msg_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userAId, lastMsgAt])
  @@index([userBId, lastMsgAt])
  @@map("conversation")
}

/// 群（2026-11-27 加的表，样稿 design/12-group.html）。只有两种来源：旅行线路的群、相亲活动的群，由系统建；用户不能自己建群。
model ChatGroup {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(50)
  /// 群头像：线路的封面 / 活动的类型图；空 = 客户端按 kind 画默认的
  avatar      String    @default("") @db.VarChar(255)
  /// 群公告：只有群主能写
  notice      String    @default("") @db.VarChar(500)
  /// 群主：线路群是领队，活动群是发起人。不能转让
  ownerId     BigInt    @map("owner_id")
  memberLimit Int       @default(200) @map("member_limit")
  /// trip=旅行线路的群 event=相亲活动的群 test=后台建的测试群
  kind        String    @default("trip") @db.VarChar(10)
  /// 对应的线路 / 活动 id（没有就是 0）
  refId       BigInt    @default(0) @map("ref_id")
  /// 0=正常 1=已解散 2=被平台关闭
  status      Int       @default(0) @db.TinyInt
  /// 活动开始 / 行程结束的时间：过了以后群里提示「N 天后自动解散」
  endAt       DateTime? @map("end_at")
  /// 到这个时间自动解散（活动群 = 活动开始后 3 天，线路群 = 行程结束后 7 天）
  expireAt    DateTime? @map("expire_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  members GroupMember[]

  @@index([ownerId])
  @@index([kind, refId])
  @@index([status, expireAt])
  @@map("chat_group")
}

/// 群成员（2026-11-27 加的表）。退群、被移出不删行，只改 status：这样之前的聊天记录还能看，被移出的人也进不回来。
model GroupMember {
  id            BigInt    @id @default(autoincrement())
  groupId       BigInt    @map("group_id")
  userId        BigInt    @map("user_id")
  /// owner|member（不设管理员）
  role          String    @default("member") @db.VarChar(10)
  /// 0=在群里 1=自己退出 2=被群主移出 3=被平台移出
  status        Int       @default(0) @db.TinyInt
  lastReadMsgId BigInt    @default(0) @map("last_read_msg_id")
  /// 消息免打扰：未读只显示灰点，不计入总未读
  muted         Boolean   @default(false)
  /// 已经解散 / 已经不在的群，从自己的消息列表里删掉
  hidden        Boolean   @default(false)
  joinedAt      DateTime  @default(now()) @map("joined_at")
  /// 退出 / 被移出的时间：这之后的群消息看不到
  leftAt        DateTime? @map("left_at")

  group ChatGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("group_member")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderId       BigInt   @map("sender_id")
  /// 对方 id
  receiverId     BigInt?  @map("receiver_id")
  /// text|image|video|audio|file|location|call
  type           String   @db.VarChar(20)
  /// AES-256-GCM 密文（iv:tag:cipher, base64），不存明文
  cipherContent  String   @map("cipher_content") @db.Text
  /// 已读标记
  isRead         Boolean  @default(false) @map("is_read")
  /// 对方读到的时间（长按菜单显示「已读 时间」）
  readAt         DateTime? @map("read_at")
  /// 回复的消息 id（同会话）
  replyToId      BigInt?  @map("reply_to_id")
  /// 转发来源：原消息发送者昵称；null = 不是转发
  fwdFrom        String?  @map("fwd_from") @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, id])
  @@index([receiverId, isRead])
  @@map("message")
}

/// 「只删自己这边」的消息：对本人隐藏，其他人照常看到
model MessageHide {
  userId         BigInt   @map("user_id")
  messageId      BigInt   @map("message_id")
  conversationId BigInt   @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([userId, messageId])
  @@index([userId, conversationId])
  @@map("message_hide")
}

/// 会话置顶消息（可置顶多条，顶部栏显示最新一条，点一下轮换）
model MessagePin {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  messageId      BigInt   @map("message_id")
  pinnedBy       BigInt   @map("pinned_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([conversationId, messageId])
  @@map("message_pin")
}

/// 消息的表情回应（表名沿用 channel_reaction）：每人每条一个，再点同一个 = 取消
model ChannelReaction {
  id        BigInt   @id @default(autoincrement())
  messageId BigInt   @map("message_id")
  userId    BigInt   @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("channel_reaction")
}

// ---------- 平台核心：音视频通话 ----------

model CallRecord {
  id         BigInt    @id @default(autoincrement())
  callId     String    @unique @map("call_id") @db.VarChar(40)
  callerId   BigInt    @map("caller_id")
  calleeId   BigInt    @map("callee_id")
  /// 1=语音 2=视频
  type       Int       @db.TinyInt
  /// 0=呼叫中 1=进行中 2=已结束 3=未接 4=拒绝 5=取消
  status     Int       @default(0) @db.TinyInt
  startedAt  DateTime? @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationSec Int      @default(0) @map("duration_sec")
  /// 本通话分配到的 SRS 节点 IP（空=用环境变量 SRS_SERVER）；负载统计与接听时下发同一节点
  srsNode    String    @default("") @map("srs_node") @db.VarChar(64)
  /// 这通视频的牵豆谁付（0 = 不收费：语音，或者发起时价格是 0）。2026-11-27 加的，见 common/video-fee.ts
  payerId    BigInt    @default(0) @map("payer_id")
  /// 发起时的价格：每分钟多少微元（1 牵豆 = 1,000,000）。通话中途后台改价不影响这一通
  priceMicro Int       @default(0) @map("price_micro")
  /// 已经扣到第几分钟（这一通一共扣了 paidMinutes × priceMicro）
  paidMinutes Int      @default(0) @map("paid_minutes")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([callerId])
  @@index([calleeId])
  @@index([status, srsNode])
  @@map("call_record")
}

/// SRS 流媒体节点（后台管理）：通话按 priority 顺序选第一个未满的节点，全满则取负载率最低者
model SrsNode {
  id             Int      @id @default(autoincrement())
  name           String   @default("") @db.VarChar(40)
  /// 公网 IP（唯一）；所有节点安装路径/端口一致
  ip             String   @unique @db.VarChar(64)
  /// HTTP API / WHIP / WHEP 端口
  apiPort        Int      @default(1985) @map("api_port")
  /// 越小越优先
  priority       Int      @default(100)
  /// 最大连接数（同时在该节点上通话的人数），超了自动落到下一个节点
  maxConnections Int      @default(40) @map("max_connections")
  enabled        Boolean  @default(true)
  /// 默认（源）节点：部署新节点时以它为模板复制源码与配置；全局仅一个
  isDefault      Boolean  @default(false) @map("is_default")
  remark         String   @default("") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("srs_node")
}

/// 客户端通话日志上报（排查视频/语音概率性问题，双端各自分批上报）
model CallClientLog {
  id        BigInt   @id @default(autoincrement())
  callId    String   @map("call_id") @db.VarChar(40)
  uid       BigInt
  /// android / ios / web
  platform  String   @db.VarChar(10)
  /// 批量日志文本，每行前带客户端时间戳
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([callId])
  @@map("call_client_log")
}

/// 视频通话结束后男方对女方的评分：5 个维度各 0-100 分，平均分为最终得分
model CallRating {
  id        BigInt   @id @default(autoincrement())
  /// 一次通话只能评一次
  callId    String   @unique @map("call_id") @db.VarChar(40)
  maleId    BigInt   @map("male_id")
  femaleId  BigInt   @map("female_id")
  /// 与照片相符
  photo     Int      @default(0)
  /// 听话程度
  obedience Int      @default(0)
  /// 腿长
  legs      Int      @default(0)
  /// 胸大
  chest     Int      @default(0)
  /// 肤白
  skin      Int      @default(0)
  /// 五项平均分（0-100）
  avg       Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([femaleId])
  @@map("call_rating")
}

/// 通话参数，后台可调，App 发起通话前拉取
model CallConfig {
  id        Int      @id @default(autoincrement())
  width     Int      @default(640)
  height    Int      @default(480)
  fps       Int      @default(25)
  /// kbps
  bitrate   Int      @default(800)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("call_config")
}

/// App 版本与更新（后台配置，每个平台一行）。客户端启动时 GET /app/version?platform=&version= 比对：
/// 低于 latest 提示更新；force=true 或 版本低于 minVersion 时强制（弹框不可关闭，只能去更新）。
/// iOS 的 url 前期填 TestFlight 公开链接，上架后改成 App Store 链接即可，客户端不用改。
model AppVersion {
  id         Int      @id @default(autoincrement())
  /// android / ios
  platform   String   @unique @db.VarChar(10)
  /// 最新版本号，如 1.2.0
  latest     String   @default("1.0") @db.VarChar(20)
  /// 低于此版本必须更新（空=不按版本强制）
  minVersion String   @default("") @map("min_version") @db.VarChar(20)
  /// 所有低于 latest 的版本都强制更新
  force      Boolean  @default(false)
  /// 下载/跳转地址：android=apk 直链；ios=TestFlight 或 App Store 链接
  url        String   @default("") @db.VarChar(500)
  /// ios 渠道：testflight / appstore（决定弹框按钮文案）
  channel    String   @default("testflight") @db.VarChar(20)
  /// 更新说明（弹框内展示，\n 换行）
  notes      String   @default("") @db.VarChar(1000)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_version")
}

/// 计费配置（金额单位：分，100分=1积分=1元）
/// 平台账本：每笔平台抽成收入落账，用于与女生对账
model PlatformLedger {
  id          BigInt   @id @default(autoincrement())
  /// video_cut=视频通话抽成
  type        String   @db.VarChar(20)
  /// 关联单号（如 call_xxx），幂等
  refKey      String   @unique @default("") @map("ref_key") @db.VarChar(60)
  maleId      BigInt   @map("male_id")
  femaleId    BigInt   @map("female_id")
  /// 计费分钟数
  minutes     Int      @default(0)
  /// 男方实付总额（分）
  grossFen    BigInt   @map("gross_fen")
  /// 女方分成（分）
  femaleFen   BigInt   @map("female_fen")
  /// 平台抽成（分）= gross - female
  platformFen BigInt   @map("platform_fen")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([femaleId, createdAt])
  @@index([createdAt])
  @@map("platform_ledger")
}

model PriceConfig {
  id                 Int      @id @default(autoincrement())
  /// 男→女 每条消息价格（分），默认 10 = 0.1 积分
  msgPriceFen        Int      @default(10) @map("msg_price_fen")
  /// 视频流量成本价（分/分钟），按 640x480@800kbps 双向流量实测约 1.2 分/分钟
  videoBaseFenPerMin Int      @default(2) @map("video_base_fen_per_min")
  /// 平台倍率 X：平台每分钟抽成 = 成本 x X（赚 X-1 倍流量费）；女生定价下限 = 成本 x X
  videoPlatformX     Int      @default(2) @map("video_platform_x")
  /// 女生须实名认证才能发布动态（男生无实名功能，不受约束）
  momentNeedRealname Boolean  @default(false) @map("moment_need_realname")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("price_config")
}

// ---------- 平台核心：钱包（1积分=1元，无充值） ----------

model Wallet {
  userId    BigInt   @id @map("user_id")
  /// 可用积分
  balance   BigInt   @default(0)
  /// 冻结积分（视频通话预冻结）
  frozen    BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallet")
}

model WalletTransaction {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// admin_grant|adjust|msg_fee|msg_income|call_freeze|call_unfreeze|call_fee|call_income
  type      String   @db.VarChar(20)
  /// 正为入账负为支出（对 balance 的变动）
  amount    BigInt
  /// 对 frozen 的变动
  frozenDelta BigInt @default(0) @map("frozen_delta")
  /// 变动后可用余额快照
  balanceAfter BigInt @map("balance_after")
  /// 关联单号（消息/通话等），幂等键
  refKey    String   @default("") @map("ref_key") @db.VarChar(60)
  remark    String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, refKey, userId])
  @@index([userId, createdAt])
  @@map("wallet_transaction")
}

// ---------- 平台核心：广场 ----------

model Moment {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// 冗余性别用于隔离过滤
  gender    Int      @db.TinyInt
  content   String   @default("") @db.VarChar(1000)
  /// 1=图文 2=视频
  type      Int      @db.TinyInt
  /// JSON 数组：图片 url 列表（MySQL TEXT 不支持默认值，用 VARCHAR）
  images    String   @default("[]") @db.VarChar(3000)
  videoUrl  String   @default("") @map("video_url") @db.VarChar(255)
  coverUrl  String   @default("") @map("cover_url") @db.VarChar(255)
  cityCode  String   @default("") @map("city_code") @db.VarChar(12)
  cityName  String   @default("") @map("city_name") @db.VarChar(30)
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)
  likeCount    Int   @default(0) @map("like_count")
  commentCount Int   @default(0) @map("comment_count")
  /// 0=正常 1=隐藏
  status    Int      @default(0) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  @@index([gender, status, id])
  @@index([gender, cityCode, status, id])
  @@index([userId])
  @@map("moment")
}

model MomentLike {
  id       BigInt   @id @default(autoincrement())
  momentId BigInt   @map("moment_id")
  userId   BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([momentId, userId])
  @@map("moment_like")
}

model MomentComment {
  id       BigInt   @id @default(autoincrement())
  momentId BigInt   @map("moment_id")
  userId   BigInt   @map("user_id")
  content  String   @default("") @db.VarChar(500)
  /// 评论图片
  imageUrl String   @default("") @map("image_url") @db.VarChar(255)
  /// 回复的评论 id
  replyToId BigInt? @map("reply_to_id")
  /// 0=正常 1=删除
  status   Int      @default(0) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  @@index([momentId, id])
  @@map("moment_comment")
}

// ---------- 平台核心：模块入口配置（大厅页动态渲染） ----------

/// 项目大厅入口（每个项目一张横幅卡，后台加卡即上线）
model AppModule {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(30)
  /// 英文名（App / 网页非中文界面显示；空则显示中文名）
  nameEn    String   @default("") @map("name_en") @db.VarChar(60)
  /// 图标 URL（小游戏宫格用，后台上传）
  icon      String   @default("") @db.VarChar(255)
  /// 项目简介（横幅卡副标题 / 小游戏说明）
  desc      String   @default("") @db.VarChar(100)
  /// 英文简介（空则显示中文）
  descEn    String   @default("") @map("desc_en") @db.VarChar(200)
  /// 封面图 URL，空则用默认渐变（横幅项目用）
  cover     String   @default("") @db.VarChar(255)
  /// native=客户端内置页 h5=内嵌网页横幅 game=小游戏（大厅宫格，App 内原生 WebView 全屏打开）
  type      String   @default("native") @db.VarChar(10)
  /// native: 路由标识；h5/game: 完整 url
  entry     String   @db.VarChar(255)
  /// 小游戏屏幕方向：portrait=竖屏 landscape=横屏（App 打开游戏页时旋转屏幕，仅该页生效）
  orientation String @default("portrait") @db.VarChar(10)
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  /// 0=全部可见 1=仅男 2=仅女（游戏类项目用 0）
  visibleGender Int  @default(0) @map("visible_gender") @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_module")
}

// ---------- 其他 ----------

/// 系统开关/配置（key-value）。目前：review_mode_ios = 1/0（iOS 审核模式：启动显示账号密码登录页）
model SysSetting {
  key       String   @id @db.VarChar(40)
  value     String   @default("") @db.VarChar(2000)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sys_setting")
}

model Region {
  code     String @id @db.VarChar(12)
  name     String @db.VarChar(30)
  /// province|city
  level    String @db.VarChar(10)
  parentCode String @default("") @map("parent_code") @db.VarChar(12)
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)

  @@index([parentCode])
  @@map("region")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(30)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_user")
}

/// 关注关系
model Follow {
  id         BigInt   @id @default(autoincrement())
  followerId BigInt   @map("follower_id")
  targetId   BigInt   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([followerId, targetId])
  @@index([targetId])
  @@map("follow")
}

/// 通知（评论/接单等分类消息）
model Notification {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  /// comment | task
  kind       String   @db.VarChar(10)
  title      String   @db.VarChar(60)
  body       String   @default("") @db.VarChar(200)
  /// 关联对象：comment=momentId task=orderId
  refId      BigInt   @default(0) @map("ref_id")
  fromUserId BigInt?  @map("from_user_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, kind, id])
  @@map("notification")
}

/// AI 助手对话记录（免费问答，按用户隔离）
model AiMessage {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// user | assistant
  role      String   @db.VarChar(10)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, id])
  @@map("ai_message")
}

model Report {
  id         BigInt   @id @default(autoincrement())
  reporterId BigInt   @map("reporter_id")
  targetUserId BigInt @map("target_user_id")
  /// user|moment|message|group（group：举报整个群，targetId = 群 id，targetUserId = 群主）
  targetType String   @map("target_type") @db.VarChar(10)
  targetId   BigInt   @default(0) @map("target_id")
  reason     String   @db.VarChar(500)
  /// 举报消息时的快照 JSON {conversationId, type, cipher}（cipher 用会话密钥加密，后台查看时解密；消息被删了也能看）
  extra      String?  @db.Text
  /// 0=待处理 1=已处理
  status     Int      @default(0) @db.TinyInt
  /// 处理结果：ignore | delete | ban
  result     String   @default("") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([reporterId, targetType, targetId])
  @@map("report")
}
