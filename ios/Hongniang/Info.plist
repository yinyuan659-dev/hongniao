<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-11-27 起服务器已经是 https://gphnai.com。这一项还留着是因为通话的 SRS 信令地址是 http://IP:1985；信令挪到 HTTPS 后收紧（送审前要做） -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>一线牵</string>
	<!-- 出口合规：只用 HTTPS / 系统加密，属豁免；免去每次上传 TestFlight 手动回答 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>视频通话、扫描二维码与聊天拍照需要使用摄像头</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>在聊天和发布动态时选择照片、视频需要访问相册</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>保存聊天图片、视频和邀请名片二维码需要访问相册</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>语音消息与通话需要使用麦克风</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于定位所在城市、距离展示与发送位置消息</string>
	<!-- 后台音频：通话退到后台后继续 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
